# Penyedia AI: "gemini" (gratis, default) atau "claude" (berbayar)
AI_PROVIDER=gemini

# Gemini: key gratis dari https://aistudio.google.com/apikey
GEMINI_API_KEY=isi-key-gemini-di-sini
# Opsional, default gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
# Model cadangan kalau model utama sibuk / kuota habis (dipisah koma)
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Claude (opsional, berbayar): https://console.anthropic.com
# Aktifkan dengan AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
